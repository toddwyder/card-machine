{
    "name":  "card-machine-dashboard",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "next dev --hostname ${DASHBOARD_HOST:?Set DASHBOARD_HOST} --port 4313",
                    "build":  "next build",
                    "start":  "next start --hostname ${DASHBOARD_HOST:?Set DASHBOARD_HOST} --port 4313",
                    "lint":  "eslint --no-config-lookup --ext .jsx,.js,.mjs --parser-options \u0027{\"ecmaVersion\":\"latest\",\"sourceType\":\"module\",\"ecmaFeatures\":{\"jsx\":true}}\u0027 --rule \u0027no-unreachable:error\u0027 --rule \u0027no-constant-condition:error\u0027 --rule \u0027eqeqeq:error\u0027 app lib tests scripts server.js playwright.config.mjs",
                    "test":  "node --test lib/*.test.mjs scripts/*.test.mjs",
                    "test:browser":  "playwright test",
                    "check:start-address":  "node scripts/check-start-address.mjs",
                    "test:e2e":  "e2e run"
                },
    "dependencies":  {
                         "@mastra/code-sdk":  "1.20.0",
                         "next":  "16.4.6",
                         "react":  "19.3.1",
                         "react-dom":  "19.3.1"
                     },
    "devDependencies":  {
                            "@e2e-dev/web":  "^0.16.1",
                            "@playwright/test":  "1.65.1",
                            "e2e":  "^0.24.0",
                            "eslint":  "10.15.0"
                        },
    "imports":  {
                    "#lib/*":  "./lib/*"
                }
}
